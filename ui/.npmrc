; New packages wait a week before we install them: a version published less
; than this many days ago is not resolved, so a compromised release has time
; to be found and pulled before it reaches a build. Matches validmind/frontend.
; A CVE fix blocked by this window needs min-release-age-exclude or a
; temporary relaxation; npm audit fix warns and exits non-zero rather than
; silently keeping the vulnerable version.
min-release-age=7
